{
  "name": "morimond-app",
  "version": "1.1.0",
  "description": "# Application de gestion des fouilles de l'abbaye de Morimond",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win --x64 --ia32",
    "dist:linux": "electron-builder --linux --x64 --arm64",
    "dist:all": "electron-builder --mac --win --linux --x64 --arm64"
  },
  "build": {
    "appId": "com.fifousoft.morimondapp",
    "productName": "App Morimond",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!morimond-app.zip",
      "!dist"
    ],
    "mac": {
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icons/png/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Philippe Bron <philippe.bron@example.com>"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philippeBron/morimond-app.git"
  },
  "keywords": [
    "carroyage",
    "morimond",
    "fouilles"
  ],
  "author": "Philippe Bron <philippe.bron@example.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/philippeBron/morimond-app/issues"
  },
  "homepage": "https://github.com/philippeBron/morimond-app#readme",
  "dependencies": {
    "electron-db": "^0.15.7",
    "path": "^0.12.7",
    "read-excel-file": "^5.5.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
